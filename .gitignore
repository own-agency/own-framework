# Build output — regenerated by `pnpm build`/`pnpm dev`. Also excludes it from
# Tailwind CSS v4's automatic content detection; without this, the Vite watch
# build's own writes into assets/ get picked up as a source change, triggering
# another build, in an infinite loop.
/assets/

# Build output of the developer page (wp-scripts) and Composer's packages
# (Plugin Update Checker); both are added to the release zip by CI.
/developer/build/
/vendor/

/node_modules/
.DS_Store
