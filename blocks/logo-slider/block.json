{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "acf/logo-slider",
    "title": "Logo slider",
    "description": "Oneindig doorlopende, automatisch scrollende band met logo's van klanten of partners.",
    "category": "own-framework",
    "icon": "controls-repeat",
    "keywords": ["logo", "logos", "klanten", "partners", "marquee", "band"],
    "acf": {
        "mode": "preview",
        "renderTemplate": "render.php",
        "blockVersion": 3
    },
    "editorScript": "file:./editor.js",
    "attributes": {
        "title": { "type": "string", "default": "" },
        "logos": {
            "type": "array",
            "default": [],
            "items": { "type": "object" }
        },
        "logoSize": { "type": "string", "default": "medium" },
        "speed": { "type": "string", "default": "medium" },
        "direction": { "type": "string", "default": "left" },
        "grayscale": { "type": "boolean", "default": false },
        "pauseOnHover": { "type": "boolean", "default": false },
        "fullWidth": { "type": "boolean", "default": false },
        "align": { "type": "string", "default": "wide" }
    },
    "supports": {
        "align": ["wide", "full"],
        "html": false,
        "anchor": false,
        "color": { "background": true, "text": true },
        "spacing": { "margin": true, "padding": true }
    }
}
