{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "acf/kaartje",
    "title": "Kaartje",
    "description": "Vaste titel/subtekst/afbeelding/tekst/knoppen-volgorde (InnerBlocks) in een kaart met eigen achtergrondkleur — voor gebruik binnen kolommen/containers, geen eigen volle-breedte-sectie zoals acf/cta.",
    "category": "own-framework",
    "icon": "id-alt",
    "keywords": ["kaart", "card", "content", "afbeelding"],
    "acf": {
        "mode": "preview",
        "renderTemplate": "render.php",
        "blockVersion": 3
    },
    "editorScript": "file:./editor.js",
    "attributes": {
        "imageFullWidth": { "type": "boolean", "default": false },
        "backgroundColor": { "type": "string", "default": "" }
    },
    "supports": {
        "html": false,
        "anchor": false,
        "color": { "background": false, "text": true, "gradients": false },
        "spacing": { "margin": true, "padding": true }
    }
}
