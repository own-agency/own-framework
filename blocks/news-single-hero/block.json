{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "acf/news-single-hero",
    "title": "Nieuws header (detail)",
    "description": "Hero voor een nieuwsbericht zelf: broodkruimelpad, titel, publicatiedatum en categorie-badges van dit bericht, op een effen kleurachtergrond.",
    "category": "own-framework-news",
    "icon": "cover-image",
    "keywords": ["nieuws", "news", "blog", "hero", "intro", "header"],
    "acf": {
        "mode": "preview",
        "renderTemplate": "render.php",
        "blockVersion": 3
    },
    "editorScript": "file:./editor.js",
    "attributes": {
        "align": { "type": "string", "default": "wide" },
        "contentAlign": { "type": "string", "default": "left" },
        "showBreadcrumbs": { "type": "boolean", "default": true },
        "backgroundColor": { "type": "string", "default": "primary" },
        "breadcrumbColor": { "type": "string", "default": "var(--wp--preset--color--base)" },
        "titleColor": { "type": "string", "default": "var(--wp--preset--color--base)" },
        "dateColor": { "type": "string", "default": "var(--wp--preset--color--base)" },
        "badgeAccentColor": { "type": "string", "default": "var(--wp--preset--color--base)" }
    },
    "supports": {
        "align": ["wide", "full"],
        "multiple": false,
        "html": false,
        "anchor": false,
        "color": { "background": true, "text": false, "gradients": false },
        "spacing": { "margin": true, "padding": true }
    }
}
