{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "acf/agenda-hero",
    "title": "Agenda header",
    "description": "Hero voor de agenda-archiefpagina: titel en tekst op een effen kleur- of verloopachtergrond. Standaard al met kleurcontrast (achtergrond \"Primair\", tekst \"Basis\").",
    "category": "own-framework-agenda",
    "icon": "cover-image",
    "keywords": ["agenda", "hero", "intro", "header"],
    "acf": {
        "mode": "preview",
        "renderTemplate": "render.php",
        "blockVersion": 3
    },
    "editorScript": "file:./editor.js",
    "attributes": {
        "backgroundColor": { "type": "string", "default": "primary" },
        "textColor": { "type": "string", "default": "base" },
        "height": { "type": "string", "default": "auto" },
        "align": { "type": "string", "default": "wide" },
        "showBreadcrumbs": { "type": "boolean", "default": false },
        "contentAlign": { "type": "string", "default": "center" },
        "accentColor": { "type": "string", "default": "" }
    },
    "supports": {
        "align": ["wide", "full"],
        "multiple": false,
        "html": false,
        "anchor": false,
        "color": { "background": true, "text": true, "gradients": true },
        "spacing": { "margin": true, "padding": true }
    }
}
