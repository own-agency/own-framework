{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "acf/agenda-uitgelicht",
    "title": "Agenda uitgelicht",
    "description": "Sectie voor op een gewone pagina: een intro (titel/tekst/knop) plus een raster of slider van agenda-momenten — de eerstvolgende, of een handmatig gekozen selectie.",
    "category": "own-framework-agenda",
    "icon": "megaphone",
    "keywords": ["agenda", "momenten", "uitgelicht", "featured", "overzicht"],
    "acf": {
        "mode": "preview",
        "renderTemplate": "render.php",
        "blockVersion": 3,
        "hideFieldsInSidebar": "true",
        "expandedEditorButtonText": "Handmatige momenten beheren"
    },
    "editorScript": "file:./editor.js",
    "attributes": {
        "align": { "type": "string", "default": "wide" },
        "source": { "type": "string", "default": "upcoming" },
        "count": { "type": "number", "default": 3 },
        "layout": { "type": "string", "default": "grid" },
        "accentColor": { "type": "string", "default": "" },
        "dateBadgeColor": { "type": "string", "default": "" },
        "cardLinkColor": { "type": "string", "default": "" },
        "navColor": { "type": "string", "default": "" },
        "showPagination": { "type": "boolean", "default": false },
        "paginationColor": { "type": "string", "default": "" }
    },
    "supports": {
        "align": ["wide", "full"],
        "multiple": false,
        "html": false,
        "anchor": false,
        "color": { "background": true, "text": true, "gradients": false },
        "spacing": { "margin": true, "padding": true }
    }
}
