{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "acf/cta",
    "title": "Call to action",
    "description": "Kop, tekst en knoppen in een afgeronde kaart met een kleur- of verloop-achtergrond, optioneel met een afbeelding naast de inhoud of als kaart-achtergrond met een kleurtint.",
    "category": "own-framework",
    "icon": "megaphone",
    "keywords": ["cta", "call to action", "banner", "actie"],
    "acf": {
        "mode": "preview",
        "renderTemplate": "render.php",
        "blockVersion": 3
    },
    "editorScript": "file:./editor.js",
    "attributes": {
        "image": { "type": "object", "default": {} },
        "imageFocalPoint": { "type": "object", "default": { "x": 0.5, "y": 0.5 } },
        "imageLayout": { "type": "string", "default": "side" },
        "imagePosition": { "type": "string", "default": "right" },
        "overlayOpacity": { "type": "number", "default": 40 },
        "cardBackgroundColor": { "type": "string", "default": "" },
        "fullWidth": { "type": "boolean", "default": false },
        "align": { "type": "string", "default": "wide" }
    },
    "supports": {
        "align": ["wide", "full"],
        "html": false,
        "anchor": false,
        "color": { "background": true, "text": true, "gradients": true },
        "spacing": { "margin": true, "padding": true }
    }
}
