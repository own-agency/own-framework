{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "acf/proces",
    "title": "Proces",
    "description": "Genummerde stappen (bv. een aanvraagproces), elke stap een eigen bewerkbare kop/tekst (acf/proces-stap).",
    "category": "own-framework",
    "icon": "list-view",
    "keywords": ["proces", "stappen", "stappenplan", "aanvraag"],
    "acf": {
        "mode": "preview",
        "renderTemplate": "render.php",
        "blockVersion": 3
    },
    "editorScript": "file:./editor.js",
    "attributes": {
        "title": { "type": "string", "default": "" },
        "stepColor": { "type": "string", "default": "" },
        "stepNumberColor": { "type": "string", "default": "" },
        "stepLineColor": { "type": "string", "default": "" },
        "align": { "type": "string", "default": "wide" }
    },
    "supports": {
        "align": ["wide", "full"],
        "html": false,
        "anchor": false,
        "color": { "background": true, "text": true },
        "spacing": { "margin": true, "padding": true }
    }
}
