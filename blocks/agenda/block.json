{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "acf/agenda",
    "title": "Agenda resultaten",
    "description": "Filteren (op agenda-categorie en periode), sorteren op datum en paginering over alle agenda-momenten. Bedoeld voor de agenda-archiefpagina.",
    "category": "own-framework-agenda",
    "icon": "calendar-alt",
    "keywords": ["agenda", "momenten", "kalender", "archief", "filters"],
    "acf": {
        "mode": "preview",
        "renderTemplate": "render.php",
        "blockVersion": 3
    },
    "editorScript": "file:./editor.js",
    "attributes": {
        "accentColor": { "type": "string", "default": "" },
        "dateBadgeColor": { "type": "string", "default": "" },
        "cardTitleColor": { "type": "string", "default": "" },
        "cardTextColor": { "type": "string", "default": "" },
        "cardBackgroundColor": { "type": "string", "default": "" },
        "cardLinkColor": { "type": "string", "default": "" },
        "perPage": { "type": "number", "default": 10 },
        "align": { "type": "string", "default": "wide" }
    },
    "supports": {
        "align": ["wide", "full"],
        "multiple": false,
        "html": false,
        "anchor": false,
        "spacing": { "margin": true, "padding": true }
    }
}
